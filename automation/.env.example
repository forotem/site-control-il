# הגדרות אוטומציה

# ===========================================
# הגדרות חובה ל-GitHub Actions
# ===========================================

# יצירת תמונות אוטומטית עם Gemini API
# true = אוטומציה מלאה עם API
# false = שמירת prompts בלבד
AUTO_GENERATE_IMAGES=true

# מפתח Gemini API (חובה ליצירת תמונות)
# קבל מפתח מ: https://makersuite.google.com/app/apikey
# ⚠️ חשוב: הוסף כ-Secret ב-GitHub Repository Settings
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# הגדרות GitHub Actions (מוגדרות אוטומטית)
# ===========================================
# CI=true  # מוגדר אוטומטית ב-GitHub Actions
# GITHUB_ACTIONS=true  # מוגדר אוטומטית

# ===========================================
# הגדרות אופציונליות
# ===========================================
